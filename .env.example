# پیکربندی پورت و محیط
NODE_ENV=development
PORT=3000

# پایگاه‌داده PostgreSQL
POSTGRES_USER=daftar_user
POSTGRES_PASSWORD=daftar_secret_password
POSTGRES_DB=daftar_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://daftar_user:daftar_secret_password@localhost:5432/daftar_db?schema=public

# کلید توکن امنیتی JWT
JWT_SECRET=super_secret_jwt_key_please_change_in_production_environment_1234567890

# کلید اصلی رمزنگاری متقارن AES-256 (دقیقاً ۶۴ کاراکتر هگزادسیمال = ۳۲ بایت)
# برای تولید کلید جدید دستور روبرو را اجرا کنید: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=c3f1e92d847b5a190e2d4c8f71a6e5b38d9c2a1f4e7b0c3d6e9a2f5b8c1d4e7a

# حداکثر حجم فایل‌های آپلود به بایت (۵۰ مگابایت)
MAX_FILE_SIZE_BYTES=52428800

# آدرس ذخیره آپلودها
UPLOAD_DIR=./uploads
