# ======================================================
# فایل پیکربندی محیط Production
# این فایل را به .env کپی کن و مقادیر را تغییر بده
# ======================================================

# محیط اجرا
NODE_ENV=production

# پایگاه‌داده PostgreSQL
# دستور تولید پسورد امن: openssl rand -hex 16
POSTGRES_USER=daftar_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=daftar_db

# کلید JWT — حداقل ۳۲ کاراکتر تصادفی
# دستور تولید: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE

# کلید رمزنگاری AES-256 — دقیقاً ۶۴ کاراکتر hex (= 32 بایت)
# دستور تولید: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE

# حداکثر حجم فایل آپلود (50MB)
MAX_FILE_SIZE_BYTES=52428800
